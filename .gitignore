.env
.env.*
*.env

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log

# Python cache
.pytest_cache/
.mypy_cache/

# DB leftovers
*.sqlite3
*.sql

# Temp
tmp/
uploads/

# ── L4.7-SOURCE-RECOVERY: recovery hygiene ───────────────────────────────────
# Keys and certificates (real ones live in /opt/ridecheck-secrets, never here)
*.pem
*.key
*.p12
# Local/throwaway databases
*.db
*.sqlite
*.sqlite3
# Backup archives and DB dumps (kept in /opt/ridecheck-backups, never in git)
*.bak
*.bak.*
*.sql.gz
*.dump
*.tar.gz
# Editor/OS noise
.DS_Store
*~
